# The pinned CommonLib header destroys an entry's value in both
# entry_type::destroy() and value_union::~value_union(). Rehashing consequently
# releases live menu references again after moving them into the new table.
# Generate an include override for every consumer, keeping the checkout clean.
set(TTCG_COMMONLIB_HASHMAP_PATCH "bsthashmap-lifetime-v1")
set(TTCG_COMMONLIB_HASHMAP_SOURCE "${TTCG_COMMONLIB_ROOT}/include/RE/B/BSTHashMap.h")
file(SHA256 "${TTCG_COMMONLIB_HASHMAP_SOURCE}" TTCG_COMMONLIB_HASHMAP_SHA256)
if(NOT TTCG_COMMONLIB_HASHMAP_SHA256 STREQUAL "546e15c190354000604d006a402e5591ad5314431f6726091996557a017576e2")
  message(FATAL_ERROR "CommonLib BSTHashMap changed; review the lifetime patch before updating the dependency")
endif()
file(READ "${TTCG_COMMONLIB_HASHMAP_SOURCE}" TTCG_COMMONLIB_HASHMAP_CONTENT)
string(REPLACE
  "value_union() :\n\t\t\t\t\tvalue() {}\n\n\t\t\t\t~value_union() { value.~value_type(); }"
  "// entry_type alone manages the lifetime of the active value.\n\t\t\t\t// Empty storage contains buffer, never a default-constructed value.\n\t\t\t\tvalue_union() noexcept {}\n\n\t\t\t\t~value_union() {}"
  TTCG_COMMONLIB_HASHMAP_CONTENT "${TTCG_COMMONLIB_HASHMAP_CONTENT}")
file(MAKE_DIRECTORY "${TTCG_COMMONLIB_OVERLAY}/RE/B")
file(CONFIGURE OUTPUT "${TTCG_COMMONLIB_OVERLAY}/RE/B/BSTHashMap.h"
  CONTENT "// Generated by cmake/CommonLibHashMapPatch.cmake; do not edit.\n#define TESSERA_COMMONLIB_BSTHASHMAP_LIFETIME_PATCH 1\n${TTCG_COMMONLIB_HASHMAP_CONTENT}" @ONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${TTCG_COMMONLIB_HASHMAP_SOURCE}")
