{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-msvc-tessera",
      "displayName": "Linux cross build (SE / AE / VR)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clangcl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/linux-msvc-toolchain.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/build/deps/commonlib/examples/linux-cross-compile/custom-ports",
        "VCPKG_TARGET_TRIPLET": "x64-windows-clangcl",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "TTCG_OUTPUT_MOD_DIR": "${sourceDir}/build/runtime-tessera"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows DLL (SE / AE / VR)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-tessera",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-ports"
      }
    },
    {
      "name": "native",
      "displayName": "Linux tests and preview",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-msvc-tessera",
      "configurePreset": "linux-msvc-tessera"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 4
    },
    {
      "name": "native",
      "configurePreset": "native",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
